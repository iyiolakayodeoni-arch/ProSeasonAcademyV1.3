# ── PROSEASONACADEMY server environment ─────────────────────
# One file, three knobs. Copy to .env and fill in.

# YOUR FOUNDER KEY — the only admin credential there is.
# It unlocks /admin, founder broadcasts, and every money move
# (top-ups, PRO activations). Keep it exactly as generated for
# you (saved in your private key notes). Never commit the real .env.
ADMIN_KEY=REPLACE-WITH-YOUR-FOUNDER-KEY

# THE TILL'S OPENING DAY (ISO date). While this is in the future,
# players see all prices but nothing can be bought or spent;
# you can already top up wallets (stocking shelves + testing).
# To open the store immediately: any past date, e.g. 2026-01-01T00:00:00Z
GO_LIVE=2027-01-01T00:00:00Z

# Port the server listens on (open it in your cloud security list).
PORT=8788
