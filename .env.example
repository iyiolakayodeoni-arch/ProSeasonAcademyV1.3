# ─────────────────────────────────────────────────────────────
# PROSEASONACADEMY — build-time environment
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build
# time. The anon key is SAFE to ship: it is the public key and
# every table is guarded by Row Level Security in Postgres.
#
# NEVER put the service_role key in this file.
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_PSA_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_PSA_SUPABASE_ANON_KEY=your-anon-public-key
