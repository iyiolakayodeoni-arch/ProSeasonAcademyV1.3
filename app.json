{
  "expo": {
    "name": "ProSeason Academy",
    "slug": "proseasonacademy",
    "version": "1.3.0",
    "orientation": "default",
    "scheme": "proseasonacademy",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0f0a",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f0a",
      "imageWidth": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "ProSeason Academy",
      "shortName": "ProSeason",
      "description": "ProSeason Academy — the premium football coaching web app for phones, tablets, laptops and TVs.",
      "lang": "en",
      "themeColor": "#0a0f0a",
      "backgroundColor": "#0a0f0a",
      "barStyle": "black-translucent",
      "startUrl": "/",
      "scopePath": "/",
      "preferRelatedApplications": false,
      "display": "standalone",
      "orientation": "any",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0f0a",
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0a0f0a",
            "image": "./assets/splash-blank.png"
          }
        }
      ]
    ]
  }
}
